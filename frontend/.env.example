# Copy to .env.local (never commit it).
# Where the API lives. Leave empty in development: the dev server proxies /api to localhost:8000.
# In production set the full URL, e.g. https://your-api.example.com/api/v1
VITE_API_URL=

# Development only: log in without Telegram as this fake Telegram id (needs DEV_AUTH_ENABLED=true in backend/.env).
VITE_DEV_TELEGRAM_ID=100000001
