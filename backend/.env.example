# Copy to backend\.env and fill in. NEVER commit .env and NEVER paste its values in a chat.
# Placeholders only in this file.
APP_ENV=development                  # development | production (production refuses to start with weak/placeholder secrets)

# Supabase -> Project Settings -> Database -> Connection string -> pooler (transaction) URI.
# Supabase shows "postgresql://..."; you must change the start to "postgresql+psycopg://".
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Each of these needs a long random value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_32_CHARS_MIN
TICK_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING
# Telegram webhook secret: 16-256 characters of A-Z a-z 0-9 _ -  (token_urlsafe gives exactly that)
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_TO_A_THIRD_RANDOM_STRING

# From @BotFather. Server-side only. Never put this in the frontend.
TELEGRAM_BOT_TOKEN=
# Where the Mini App lives (https only in production)
MINI_APP_URL=https://your-frontend.vercel.app
# Comma-separated Telegram numeric ids that become admin when they first log in
ADMIN_TELEGRAM_IDS=

# Browser origins allowed to call the API (comma-separated, https in production, no "*")
CORS_ORIGINS=http://localhost:5173

# Local development only. The server refuses to start with this on when APP_ENV=production.
DEV_AUTH_ENABLED=false

# Price providers. CoinGecko Demo key is optional but recommended (free at coingecko.com).
COINGECKO_API_KEY=
# WIENER is priced from DexScreener. A pool thinner than this (USD liquidity) is not trusted:
DEX_MIN_LIQUIDITY_USD=20000
